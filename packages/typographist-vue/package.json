{
  "name": "@elmenov-softworks/typographist-vue",
  "version": "1.0.3",
  "description": "Vue Composition API provider, leaf text component and composable for typography and soft hyphenation.",
  "type": "module",
  "author": "Alex Elmenov",
  "license": "MIT",
  "keywords": [
    "typographist",
    "typography",
    "text-formatting",
    "hyphenation",
    "soft-hyphen",
    "quotes",
    "dashes",
    "nonbreaking-spaces",
    "unicode",
    "i18n",
    "localization",
    "javascript",
    "typescript",
    "vue",
    "vue3",
    "composition-api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elmenov-Softworks/typographist.git",
    "directory": "packages/typographist-vue"
  },
  "homepage": "https://elmenov-softworks.github.io/typographist/",
  "bugs": {
    "url": "https://github.com/Elmenov-Softworks/typographist/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "typographist-vue",
    "tags": [
      "npm-public"
    ],
    "targets": {
      "nx-release-publish": {
        "executor": "@nx/js:release-publish",
        "options": {},
        "dependsOn": [],
        "cache": false
      }
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vue-tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@elmenov-softworks/typographist": "1.0.3"
  },
  "peerDependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "vue": "3.5.43"
  }
}
