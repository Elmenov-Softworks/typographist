{
  "name": "@elmenov-softworks/typographist-vue",
  "version": "0.1.0",
  "description": "Typography components for Vue.",
  "type": "module",
  "author": "Alex Elmenov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elmenov-Softworks/typographist.git",
    "directory": "packages/typographist-vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "typographist-vue",
    "tags": [
      "npm-public"
    ],
    "targets": {
      "nx-release-publish": {
        "executor": "@nx/js:release-publish",
        "options": {},
        "dependsOn": [],
        "cache": false
      }
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vue-tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@elmenov-softworks/typographist": "0.1.0"
  },
  "peerDependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "vue": "3.5.43"
  }
}
