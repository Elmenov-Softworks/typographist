{
  "name": "@elmenov-softworks/typographist-react",
  "version": "1.0.0",
  "description": "React provider, leaf text component and hook for locale-aware typography and soft hyphenation.",
  "type": "module",
  "author": "Alex Elmenov",
  "license": "MIT",
  "keywords": [
    "typography",
    "hyphenation",
    "quotes",
    "nonbreaking-spaces",
    "i18n",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elmenov-Softworks/typographist.git",
    "directory": "packages/typographist-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "typographist-react",
    "tags": [
      "npm-public"
    ],
    "targets": {
      "nx-release-publish": {
        "executor": "@nx/js:release-publish",
        "options": {},
        "dependsOn": [],
        "cache": false
      }
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@elmenov-softworks/typographist": "1.0.0"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "react": "19.3.0",
    "react-dom": "^19.3.0"
  }
}
