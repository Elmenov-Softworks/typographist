{
  "name": "@elmenov-softworks/typographist-react",
  "version": "0.1.0",
  "description": "Typography components for React.",
  "type": "module",
  "author": "Alex Elmenov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elmenov-Softworks/typographist.git",
    "directory": "packages/typographist-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "typographist-react",
    "tags": [
      "npm-public"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@elmenov-softworks/typographist": "0.1.0"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "react": "19.3.0",
    "@types/react": "19.3.0"
  }
}
