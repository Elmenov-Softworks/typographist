{
  "name": "@elmenov-softworks/typographist-solid",
  "version": "1.0.0",
  "description": "Solid provider, leaf text component and reactive hook for locale-aware typography and soft hyphenation.",
  "type": "module",
  "author": "Alex Elmenov",
  "license": "MIT",
  "keywords": [
    "typographist",
    "typography",
    "text-formatting",
    "hyphenation",
    "soft-hyphen",
    "quotes",
    "dashes",
    "nonbreaking-spaces",
    "unicode",
    "i18n",
    "localization",
    "javascript",
    "typescript",
    "solid-js",
    "solidjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elmenov-Softworks/typographist.git",
    "directory": "packages/typographist-solid"
  },
  "homepage": "https://elmenov-softworks.github.io/typographist/",
  "bugs": {
    "url": "https://github.com/Elmenov-Softworks/typographist/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "typographist-solid",
    "tags": [
      "npm-public"
    ],
    "targets": {
      "nx-release-publish": {
        "executor": "@nx/js:release-publish",
        "options": {},
        "dependsOn": [],
        "cache": false
      }
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@elmenov-softworks/typographist": "1.0.0"
  },
  "peerDependencies": {
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "solid-js": "1.9.17"
  }
}
