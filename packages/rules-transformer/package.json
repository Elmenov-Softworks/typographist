{
  "name": "@elmenov-softworks/rules-transformer",
  "version": "1.0.0",
  "description": "CLI for converting TeX hyphenation tables to TypeScript locale rules.",
  "type": "module",
  "author": "Alex Elmenov",
  "license": "MIT",
  "keywords": [
    "typographist",
    "hyphenation",
    "hyphenation-patterns",
    "knuth-liang",
    "tex",
    "locale",
    "i18n",
    "typescript",
    "cli",
    "converter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elmenov-Softworks/typographist.git",
    "directory": "packages/rules-transformer"
  },
  "homepage": "https://elmenov-softworks.github.io/typographist/",
  "bugs": {
    "url": "https://github.com/Elmenov-Softworks/typographist/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rules-transformer",
    "tags": [
      "npm-public"
    ],
    "targets": {
      "nx-release-publish": {
        "executor": "@nx/js:release-publish",
        "options": {},
        "dependsOn": [],
        "cache": false
      }
    }
  },
  "exports": {
    ".": {
      "types": {
        "typographist-source": "./src/index.ts",
        "default": "./dist/index.d.ts"
      },
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts"
  },
  "bin": {
    "transform-rules": "./dist/cli.js"
  },
  "imports": {
    "#src/*.js": {
      "typographist-source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  }
}
