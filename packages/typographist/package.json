{
  "name": "@elmenov-softworks/typographist",
  "version": "0.1.0",
  "description": "Typography utilities for JavaScript.",
  "type": "module",
  "author": "Alex Elmenov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elmenov-Softworks/typographist.git",
    "directory": "packages/typographist"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "typographist",
    "tags": [
      "npm-public"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts"
  }
}
