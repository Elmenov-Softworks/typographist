{
  "name": "@elmenov-softworks/typographist",
  "version": "1.0.1",
  "description": "Locale-aware quotes, dashes, nonbreaking spaces and soft hyphenation for JavaScript and TypeScript.",
  "type": "module",
  "author": "Alex Elmenov",
  "license": "MIT",
  "keywords": [
    "typography",
    "hyphenation",
    "quotes",
    "nonbreaking-spaces",
    "i18n",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elmenov-Softworks/typographist.git",
    "directory": "packages/typographist"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "typographist",
    "tags": [
      "npm-public"
    ],
    "targets": {
      "nx-release-publish": {
        "executor": "@nx/js:release-publish",
        "options": {},
        "dependsOn": [],
        "cache": false
      }
    }
  },
  "exports": {
    ".": {
      "types": {
        "typographist-source": "./src/index.ts",
        "default": "./dist/index.d.ts"
      },
      "import": "./dist/index.js"
    },
    "./internal/provider": {
      "types": {
        "typographist-source": "./src/integrations/prepare-provider.factory.ts",
        "default": "./dist/integrations/prepare-provider.factory.d.ts"
      },
      "import": "./dist/integrations/prepare-provider.factory.js"
    }
  },
  "files": [
    "dist",
    "locale-rules",
    "EXAMPLES.md",
    "AGENT_GUIDE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts"
  },
  "imports": {
    "#src/*.js": {
      "typographist-source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  }
}
