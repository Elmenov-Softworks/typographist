{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Typographist",
  "entryPointStrategy": "packages",
  "entryPoints": ["packages/*"],
  "packageOptions": {
    "entryPoints": ["src/index.ts"],
    "readme": "none"
  },
  "out": "docs",
  "readme": "README.md",
  "cleanOutputDir": false,
  "projectDocuments": ["packages/typographist/EXAMPLES.md"],
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "html",
    "javascript",
    "json",
    "jsonc",
    "json5",
    "yaml",
    "tsx",
    "typescript",
    "vue"
  ]
}
