  "profileHarnessSource": "import { performance } from 'node:perf_hooks';\nimport { writeFile } from 'node:fs/promises';\nimport { Typographist } from './baseline-dist/index.js';\nimport { scanAddresses } from './baseline-dist/text/scanning/scan-addresses.util.js';\nimport { createTypographyWorkloads } from '/home/alex/projects/elmenov-softworks/typographist/tools/benchmarks/typography/workloads.factory.ts';\n\nconst workloads = createTypographyWorkloads().filter(({ name }) => name.startsWith('long-'));\nfor (const locale of ['en', 'ru']) workloads.push({\n  locale, name: 'prose-' + locale, text: (locale === 'ru'\n    ? 'Читатель видит \"типографику\" - простое предложение... В понедельник см. стр. 12. Это помогает читать. '\n    : 'The \"reader\" can enjoy typography - a simple sentence... On Monday, see page 12. It\\'s helpful. ').repeat(160),\n});\nconst profiles = [[], ['quotes'], ['dashes'], ['punctuation'], ['nonbreakingSpacing'], ['quotes', 'dashes', 'punctuation', 'nonbreakingSpacing']];\nconst median = samples => [...samples].sort((a,b)=>a-b)[Math.floor(samples.length / 2)];\nconst results = [];\nlet consumed = 0;\nfor (const workload of workloads) {\n  for (const categories of profiles) {\n    const service = new Typographist({ categories, useFast: true, cacheSize: 0,\n      settings: { 'common/punctuation/quote': { spacing: false } } });\n    for (let i = 0; i < 20; i++) consumed += service.format(workload.text, workload.locale).length;\n    const samples = [];\n    for (let sample = 0; sample < 9; sample++) {\n      const start = performance.now();\n      for (let i = 0; i < 20; i++) consumed += service.format(workload.text, workload.locale).length;\n      samples.push((performance.now() - start) / 20);\n    }\n    const result = { workload: workload.name, categories, medianMs: median(samples), samplesMs: samples };\n    results.push(result);\n    console.log(JSON.stringify(result));\n  }\n  const start = performance.now();\n  for (let i = 0; i < 500; i++) consumed += scanAddresses(workload.text).length;\n  console.log('scanner',workload.name,(performance.now()-start)/500);\n}\nawait writeFile('/tmp/typographist-symbolic-profile/categories-before.json', JSON.stringify({results, consumed}, null, 2));\n",
