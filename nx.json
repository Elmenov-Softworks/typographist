{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "master",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/**/*.spec.ts", "!{projectRoot}/vitest.config.ts"],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.ts",
      "{workspaceRoot}/vitest.config.ts"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "nx-release-publish": {
      "dependsOn": [],
      "cache": false
    }
  },
  "release": {
    "groups": {
      "libraries": {
        "projects": ["typographist", "typographist-vue", "typographist-react", "typographist-solid"],
        "projectsRelationship": "fixed"
      }
    },
    "releaseTag": {
      "pattern": "v{version}",
      "checkAllBranchesWhen": false
    },
    "version": {
      "currentVersionResolver": "disk",
      "manifestRootsToUpdate": ["{projectRoot}"],
      "versionPrefix": "",
      "preserveMatchingDependencyRanges": false,
      "adjustSemverBumpsForZeroMajorVersion": false,
      "git": {
        "commit": false,
        "tag": false,
        "push": false
      }
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "file": "{projectRoot}/CHANGELOG.md",
        "createRelease": false,
        "entryWhenNoChanges": "No code changes.",
        "renderOptions": {
          "authors": false,
          "applyUsernameToAuthors": false
        }
      },
      "automaticFromRef": true,
      "git": {
        "commit": false,
        "tag": false,
        "push": false
      }
    },
    "conventionalCommits": {
      "types": {
        "__INVALID__": {
          "semverBump": "none",
          "changelog": {
            "title": "Changes",
            "hidden": false
          }
        }
      }
    }
  }
}
