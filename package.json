{
  "name": "@elmenov-softworks/typographist-workspace",
  "version": "0.1.0",
  "description": "Typography libraries for JavaScript, Vue, React, and Solid.",
  "private": true,
  "type": "module",
  "author": "Alex Elmenov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elmenov-Softworks/typographist.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "typecheck": "tsc --noEmit && nx run-many -t typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "nx": "23.2.1",
    "@nx/js": "23.2.1",
    "typescript": "6.0.3",
    "@types/node": "24.19.1",
    "tsc-alias": "1.9.7",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.1",
    "globals": "17.13.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "prettier": "3.9.9",
    "eslint-config-prettier": "10.1.8",
    "vitest": "5.0.3",
    "vite": "8.3.2",
    "@vitejs/plugin-vue": "6.0.9",
    "vue-tsc": "3.3.12",
    "eslint-plugin-vue": "10.11.1",
    "vue-eslint-parser": "10.4.1",
    "vite-plugin-solid": "2.11.14",
    "typedoc": "0.28.20",
    "jiti": "2.7.0"
  }
}
